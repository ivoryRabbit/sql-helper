# PostgreSQL
DB_HOST=0.0.0.0
DB_PORT=5432
DB_USER=sqlhelper
DB_PASSWORD=sqlhelper
DB_NAME=vectordb

# Temporal
TEMPORAL_ADDRESS=localhost:7233

# MinIO (ROOT_USER/PASSWORD sets Docker credentials; ACCESS/SECRET_KEY used by backend client — values must match)
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=sqlhelper
MINIO_ROOT_PASSWORD=sqlhelper
MINIO_ACCESS_KEY=sqlhelper
MINIO_SECRET_KEY=sqlhelper

# LLM provider: "openai" | "gemini" | "anthropic" (default: openai)
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (used when LLM_PROVIDER=gemini)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Anthropic Claude (used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Encryption key for data-source credentials (base64-encoded 32 bytes)
# Generate: python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Embedding model (default: all-MiniLM-L6-v2)
EMBEDDING_MODEL=all-MiniLM-L6-v2
